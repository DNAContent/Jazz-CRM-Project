      "id": "9875f254-4da6-4e5b-ac3b-59510d186a12",
      "name": "Get Agreement Details",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [864, 480]
    },
    {
      "parameters": {
        "jsCode": "// ─── Parse agreement item ────────────────────────────────────────────────\nconst item = $input.first().json.data.items[0];\nif (!item) throw new Error('Monday item not found in response');\n\nconst cols = {};\nfor (const col of item.column_values) {\n  try { cols[col.id] = col.value ? JSON.parse(col.value) : null; }\n  catch(e) { cols[col.id] = col.value; }\n  cols[col.id + '__text'] = col.text;\n}\n\n// ─── Core client info ────────────────────────────────────────────────────\nconst clientName   = item.name;\nconst firstName    = cols['text_mm1sys6v__text'] || '';\nconst lastName     = cols['short_text1oxj0f3m__text'] || '';\nconst clientEmail  = cols['email_mm1st5e9__text'] || '';\nconst dateSigned   = (cols['date_mm1s7q2s'] || {}).date || null;\nconst today        = new Date().toISOString().split('T')[0];\n\n// ─── Map service checkboxes → Client Database dropdown labels ─────────────\nconst svcSet = new Set();\nconst chk = id => cols[id] && cols[id].checked === 'true';\nif (chk('booleankz6r6wfo') || chk('booleaneier0pdj')) svcSet.add('Strategy');\nif (cols['multi_select5y87oaju__text'])                svcSet.add('Creative');\nif (chk('booleantdu79dpj'))                            svcSet.add('Ads');\nif (chk('boolean0n215rqt') || chk('booleanbto2nwfp'))  svcSet.add('LI Outreach');\nif (chk('booleanltdvfg3r'))                            svcSet.add('Content');\nconst services = [...svcSet];\n\n// ─── Slack channel name (lowercase, dashes) ───────────────────────────────\nconst slackChannelName = clientName\n  .toLowerCase()\n  .replace(/[^a-z0-9\\s-]/g, '')\n  .replace(/\\s+/g, '-')\n  .replace(/-+/g, '-')\n  .slice(0, 80);\n\n// ─── Build Monday Client Database mutation ───────────────────────────────\nconst clientDBCols = {\n  status58: { label: 'Onboarding' },\n  date_agreement_signed: { date: today },\n  date4: { date: dateSigned || today }\n};\nif (services.length > 0) clientDBCols.dropdown0 = { labels: services };\n\nconst createClientDBBody = JSON.stringify({\n  query: 'mutation { create_item(' +\n    'board_id: 1050013805, ' +\n    'group_id: \"topics\", ' +\n    'item_name: ' + JSON.stringify(clientName) + ', ' +\n    'column_values: ' + JSON.stringify(JSON.stringify(clientDBCols)) +\n    ') { id } }'\n});\n\n// ─── Build Campaign Calendar duplication mutation ────────────────────────\nconst calendarName = clientName + ' Campaign Calendar';\nconst duplicateCalendarBody = JSON.stringify({\n  query: 'mutation { duplicate_board(' +\n    'board_id: 1769173441, ' +\n    'duplicate_type: duplicate_board_with_pulses, ' +\n    'board_name: ' + JSON.stringify(calendarName) + ', ' +\n    'workspace_id: 5013168' +\n    ') { board { id name } } }'\n});\n\n// ─── Build Slack channel creation body ───────────────────────────────────\nconst slackCreateChannelBody = JSON.stringify({\n  name: slackChannelName,\n  is_private: false\n});\n\n// ─── Output ───────────────────────────────────────────────────────────────\nreturn [{ json: {\n  itemId:               item.id,\n  clientName,\n  firstName,\n  lastName,\n  clientEmail,\n  dateSigned:           dateSigned || today,\n  agreementPaidDate:    today,\n  services,\n  slackChannelName,\n  calendarName,\n  createClientDBBody,\n  duplicateCalendarBody,\n  slackCreateChannelBody\n}}];"
      },
